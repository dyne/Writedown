{
  "name": "writedown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x", "npm": "11.x" },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verify-assets.ts && vite build",
    "assets:prepare": "node scripts/prepare-assets.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run test:unit && npm run build && npm run test:browser"
  },
  "dependencies": {
    "texlyre-busytex": "1.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "typescript": "7.0.2",
    "vite": "8.4.0"
  }
}
